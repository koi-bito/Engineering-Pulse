# -----------------------------------------------------------------------------
# Environment Parity
# -----------------------------------------------------------------------------
# Runtime mode: "local" (LocalStack S3, verbose logs) or "production" (real AWS, JSON logs)
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# PostgreSQL (Single source of truth for DB connection; never derived from ENVIRONMENT)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=engineering_pulse
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/engineering_pulse
# Prod:  postgresql+asyncpg://<user>:<password>@<rds-endpoint>:5432/engineering_pulse
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/engineering_pulse

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
# Set to false in prod during Phases 1-4 to keep ES off the t3.large
ES_ENABLED=true

# -----------------------------------------------------------------------------
# AWS / S3 (LocalStack locally; omit AWS_ENDPOINT_URL in production)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=engineering-pulse-raw-events

# -----------------------------------------------------------------------------
# API & CORS
# -----------------------------------------------------------------------------
# Comma-separated allowed origins (never "*" when allow_credentials=True)
# Local: http://localhost:5173
# Prod:  https://<cloudfront-domain>
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Webhooks & Rate Limiting (fill locally in .env; never commit real secrets)
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
WEBHOOK_RATE_LIMIT=100/minute

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
# Local: http://localhost:8000
# Prod:  https://<api-domain>
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Grafana (Local Dev)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

